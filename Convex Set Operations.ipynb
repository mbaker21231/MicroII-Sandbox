    "import skgeom as sg\n",
    "from skgeom import minkowski\n",
    "from skgeom.draw import draw"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "4b47d27b",
   "metadata": {},
   "source": [
    "Defining a few polygons..."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 23,
   "id": "f91f07d8",
   "metadata": {},
   "outputs": [],
   "source": [
    "p1 = sg.Polygon([sg.Point2(-1, -1), sg.Point2(1, -1), sg.Point2(0, 1)])\n",
    "p2 = sg.Polygon([sg.Point2(3, -1), sg.Point2(5, -1), sg.Point2(5, 1), sg.Point2(3, 1)])\n",
    "p3 = sg.Polygon([sg.Point2(3, -3), sg.Point2(5, -3), sg.Point2(5,-7), sg.Point2(4, -4)])"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 24,
   "id": "0175e3b4",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "\n",
      "text/plain": [
       "<Figure size 640x480 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "draw(p1, facecolor='red')\n",
    "draw(p2, facecolor='blue')\n",
    "draw(p3, facecolor='green')"
   ]
  },
  {
